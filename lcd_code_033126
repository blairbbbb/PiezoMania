#include <LiquidCrystal.h>

// LCD pin connections
#define RS 2
#define EN 3
#define D4 4
#define D5 5
#define D6 6
#define D7 7

LiquidCrystal lcd(RS, EN, D4, D5, D6, D7);


void setup() {
  lcd.begin(20, 4);
  lcd.clear();

  // Optional: print static labels once
  lcd.setCursor(0, 0); lcd.print("Bus:   ");
  lcd.setCursor(0, 1); lcd.print("Load: ");
  lcd.setCursor(0, 2); lcd.print("Current:  ");
  lcd.setCursor(0, 3); lcd.print("Power:   ");
}

void loop() {

  busvoltage = ina219.getBusVoltage_V();
  shuntvoltage = ina219.getShuntVoltage_mV();
  loadvoltage = busvoltage + (shuntvoltage / 1000);
  current_mA = ina219.getCurrent_mA();
  power_mW = ina219.getPower_mW();

  // Line 1: Bus Voltage
  lcd.setCursor(6, 0);
  lcd.print(busvoltage, 2);
  lcd.print(" V   ");

  // Line 2: Load Voltage
  lcd.setCursor(6, 1);
  lcd.print(loadvoltage, 2);
  lcd.print(" V   ");

  // Line 3: Current
  lcd.setCursor(6, 2);
  lcd.print(current_mA, 1);
  lcd.print(" mA ");

  // Line 4: Power
  lcd.setCursor(6, 3);
  lcd.print(power_mW, 0);
  lcd.print(" mW   ");

  delay(300);
}
